@model HakedisYonetimSistemi.Models.Hakedis

@{
    ViewData["Title"] = $"Hakediş {Model.HakedisNo} Düzenle";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-pencil"></i> Hakediş Düzenle</h1>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Geri Dön
    </a>
</div>

<!-- Durum Uyarısı -->
@if (Model.Durum == HakedisDurum.Onaylandi || Model.Durum == HakedisDurum.Odendi)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> 
        <strong>Uyarı!</strong> Onaylanan veya ödenen hakediş'ler düzenlenemez.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-action="Edit" method="post" id="hakedisForm">
    <input type="hidden" asp-for="Id" />
    
    <div class="row">
        <!-- SOL KOLON: Genel Bilgiler -->
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h6><i class="bi bi-info-circle"></i> Genel Bilgiler</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="HakedisNo" class="form-label"></label>
                        <input asp-for="HakedisNo" class="form-control" placeholder="Örn: 2024-001" />
                        <span asp-validation-for="HakedisNo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="HakedisTarihi" class="form-label"></label>
                        <input asp-for="HakedisTarihi" class="form-control" type="date" />
                        <span asp-validation-for="HakedisTarihi" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ProjeId" class="form-label"></label>
                        <select asp-for="ProjeId" class="form-select" id="projeSelect">
                            <option value="">-- Proje Seçin --</option>
                            @if (ViewBag.Projeler != null)
                            {
                                @foreach (var proje in ViewBag.Projeler)
                                {
                                    <option value="@proje.Id" selected="@(Model.ProjeId == proje.Id ? "selected" : null)">@proje.ProjeAdi</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="ProjeId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Aciklama" class="form-label"></label>
                        <textarea asp-for="Aciklama" class="form-control" rows="3" placeholder="Açıklama (isteğe bağlı)"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- SAĞ KOLON: Dönem ve KDV -->
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h6><i class="bi bi-calendar2"></i> Dönem Bilgileri</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="DonemBaslangic" class="form-label"></label>
                        <input asp-for="DonemBaslangic" class="form-control" type="date" />
                        <span asp-validation-for="DonemBaslangic" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DonemBitis" class="form-label"></label>
                        <input asp-for="DonemBitis" class="form-control" type="date" />
                        <span asp-validation-for="DonemBitis" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="KdvOrani" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="KdvOrani" class="form-control" type="number" step="0.01" min="0" max="100" id="kdvOrani" />
                            <span class="input-group-text">%</span>
                        </div>
                        <span asp-validation-for="KdvOrani" class="text-danger"></span>
                    </div>

                    <div class="alert alert-info">
                        <small><strong>Durum:</strong> @Model.Durum</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DETAY KALEMLERİ (Dinamik Tablo) -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6><i class="bi bi-list-check"></i> Yapılan İşler</h6>
            <button type="button" class="btn btn-sm btn-success" id="addRowBtn">
                <i class="bi bi-plus"></i> Satır Ekle
            </button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped" id="detayTable">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 35%;">Yapılan İş Adı</th>
                            <th style="width: 15%;">Miktar</th>
                            <th style="width: 15%;">Birim</th>
                            <th style="width: 20%;">Birim Fiyat (₺)</th>
                            <th style="width: 15%;">Toplam (₺)</th>
                            <th style="width: 10%; text-align: center;">İşlem</th>
                        </tr>
                    </thead>
                    <tbody id="detayBody">
                        @if (Model.HakedisDetaylari != null && Model.HakedisDetaylari.Count > 0)
                        {
                            int detayIndex = 0;
                            @foreach (var detay in Model.HakedisDetaylari.ToList())
                            {
                                <tr class="detay-row">
                                    <td>
                                        <input type="text" class="form-control detay-adin" name="HakedisDetaylari[@detayIndex].Aciklama" value="@detay.Aciklama" placeholder="Örn: Duvar örülmesi" />
                                    </td>
                                    <td>
                                        <input type="number" class="form-control detay-miktar" name="HakedisDetaylari[@detayIndex].Miktar" value="@detay.Miktar" placeholder="0.00" step="0.01" min="0" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control detay-birim" name="HakedisDetaylari[@detayIndex].Birim" placeholder="m2, adet, saat" />
                                    </td>
                                    <td>
                                        <input type="number" class="form-control detay-birimfiyat" name="HakedisDetaylari[@detayIndex].BirimFiyat" value="@detay.BirimFiyat" placeholder="0.00" step="0.01" min="0" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control detay-toplam" value="@detay.ToplamTutar.ToString("F2")" readonly />
                                    </td>
                                    <td style="text-align: center;">
                                        <button type="button" class="btn btn-sm btn-danger delete-row-btn">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                                detayIndex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ÖZET BİLGİLER -->
    <div class="row">
        <div class="col-md-6 offset-md-6">
            <div class="card">
                <div class="card-body">
                    <div class="row mb-2">
                        <div class="col-8"><strong>Ara Toplam (₺):</strong></div>
                        <div class="col-4 text-end"><span id="araToplam">0.00</span></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-8"><strong>KDV (%<span id="kdvYuzde">20</span>):</strong></div>
                        <div class="col-4 text-end"><span id="kdvTutari">0.00</span></div>
                    </div>
                    <hr>
                    <div class="row">
                        <div class="col-8"><h5><strong>Genel Toplam (₺):</strong></h5></div>
                        <div class="col-4 text-end"><h5 class="text-success"><strong><span id="genelToplam">0.00</span></strong></h5></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BUTONLAR -->
    <div class="mt-4 text-end">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary me-2">
            <i class="bi bi-x-circle"></i> İptal
        </a>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save"></i> Değişiklikleri Kaydet
        </button>
    </div>
</form>

@section Scripts {
<script>
    let rowCount = @Model.HakedisDetaylari?.Count ?? 0;

    // Satır Ekle Butonu
    $('#addRowBtn').click(function () {
        const newRow = `
            <tr class="detay-row">
                <td>
                    <input type="text" class="form-control detay-adin" name="HakedisDetaylari[${rowCount}].Aciklama" placeholder="Örn: Duvar örülmesi" />
                </td>
                <td>
                    <input type="number" class="form-control detay-miktar" name="HakedisDetaylari[${rowCount}].Miktar" placeholder="0.00" step="0.01" min="0" />
                </td>
                <td>
                    <input type="text" class="form-control detay-birum" name="HakedisDetaylari[${rowCount}].Birim" placeholder="m2, adet, saat" />
                </td>
                <td>
                    <input type="number" class="form-control detay-birimfiyat" name="HakedisDetaylari[${rowCount}].BirimFiyat" placeholder="0.00" step="0.01" min="0" />
                </td>
                <td>
                    <input type="text" class="form-control detay-toplam" readonly />
                </td>
                <td style="text-align: center;">
                    <button type="button" class="btn btn-sm btn-danger delete-row-btn">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
        `;
        $('#detayBody').append(newRow);
        rowCount++;
    });

    // Satır Sil
    $(document).on('click', '.delete-row-btn', function () {
        $(this).closest('tr').remove();
        updateTotals();
    });

    // Miktar/Fiyat değiştiğinde toplam güncelle
    $(document).on('change keyup', '.detay-miktar, .detay-birimfiyat', function () {
        const row = $(this).closest('tr');
        const miktar = parseFloat(row.find('.detay-miktar').val()) || 0;
        const birimFiyat = parseFloat(row.find('.detay-birimfiyat').val()) || 0;
        const toplam = miktar * birimFiyat;
        row.find('.detay-toplam').val(toplam.toFixed(2));
        updateTotals();
    });

    // KDV Oranı değiştiğinde güncelle
    $('#kdvOrani').on('change keyup', function () {
        updateTotals();
    });

    // Toplam değerleri güncelle
    function updateTotals() {
        let araToplam = 0;
        $('.detay-toplam').each(function () {
            araToplam += parseFloat($(this).val()) || 0;
        });

        const kdvOrani = parseFloat($('#kdvOrani').val()) || 0;
        const kdvTutari = araToplam * (kdvOrani / 100);
        const genelToplam = araToplam + kdvTutari;

        $('#araToplam').text(araToplam.toFixed(2));
        $('#kdvYuzde').text(kdvOrani.toFixed(2));
        $('#kdvTutari').text(kdvTutari.toFixed(2));
        $('#genelToplam').text(genelToplam.toFixed(2));
    }

    // Form gönderilirken
    $('#hakedisForm').on('submit', function (e) {
        let detayCount = $('.detay-row').length;
        if (detayCount === 0) {
            alert('Lütfen en az bir satır ekleyiniz!');
            e.preventDefault();
            return false;
        }

        // Input isimlerini düzelt
        let index = 0;
        $('.detay-row').each(function () {
            const row = $(this);
            row.find('input').each(function () {
                const name = $(this).attr('name');
                const newName = name.replace(/HakedisDetaylari\[\d+\]/, `HakedisDetaylari[${index}]`);
                $(this).attr('name', newName);
            });
            index++;
        });
    });

    // Sayfa açılışında totalleri güncelle
    $(document).ready(function () {
        updateTotals();
    });
</script>
}
