@model IEnumerable<HakedisYonetimSistemi.Models.Hakedis>

@{
    ViewData["Title"] = "Hakediş Listesi";
    var projeId = ViewBag.ProjeId as int?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1><i class="bi bi-receipt"></i> Hakediş Listesi</h1>
        @if (projeId.HasValue)
        {
            <p class="text-muted mb-0">Proje ID: <strong>@projeId</strong></p>
        }
    </div>
    <div>
        @if (projeId.HasValue)
        {
            <a asp-controller="Proje" asp-action="Details" asp-route-id="@projeId" class="btn btn-outline-secondary me-2">
                <i class="bi bi-arrow-left"></i> Projeye Dön
            </a>
        }
        <a asp-action="Create" asp-route-projeId="@projeId" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni Hakediş
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table id="hakedisTable" class="table table-hover table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Hakediş No</th>
                            <th data-type="date">Hakediş Tarihi</th>
                            <th data-type="date">Dönem Başı</th>
                            <th data-type="date">Dönem Sonu</th>
                            <th data-type="num">Hakediş Tutarı</th>
                            <th data-type="num">KDV (%)</th>
                            <th data-type="num">Genel Toplam</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.HakedisNo</strong>
                                </td>
                                <td data-sort="@item.HakedisTarihi.ToString("yyyy-MM-dd")">
                                    @item.HakedisTarihi.ToString("dd.MM.yyyy")
                                </td>
                                <td data-sort="@item.DonemBaslangic.ToString("yyyy-MM-dd")">
                                    @item.DonemBaslangic.ToString("dd.MM.yyyy")
                                </td>
                                <td data-sort="@item.DonemBitis.ToString("yyyy-MM-dd")">
                                    @item.DonemBitis.ToString("dd.MM.yyyy")
                                </td>
                                <td data-sort="@item.HakedisTutari.ToString().Replace(",", ".")">
                                    @item.HakedisTutari.ToString("C", new System.Globalization.CultureInfo("tr-TR"))
                                </td>
                                <td>
                                    @item.KdvOrani.ToString("F2")%
                                </td>
                                <td data-sort="@item.ToplamTutar.ToString().Replace(",", ".")">
                                    <strong class="text-success">@item.ToplamTutar.ToString("C", new System.Globalization.CultureInfo("tr-TR"))</strong>
                                </td>
                                <td>
                                    <span class="badge bg-@(item.Durum == HakedisYonetimSistemi.Models.HakedisDurum.Hazirlaniyor ? "secondary" : 
                                                          item.Durum == HakedisYonetimSistemi.Models.HakedisDurum.Onayda ? "warning" : 
                                                          item.Durum == HakedisYonetimSistemi.Models.HakedisDurum.Onaylandi ? "info" : 
                                                          item.Durum == HakedisYonetimSistemi.Models.HakedisDurum.Odendi ? "success" : "danger")">
                                        @item.Durum
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Detaylar">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Düzenle">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="#" class="btn btn-sm btn-outline-success" title="PDF İndir" onclick="printHakedisPDF(@item.Id); return false;">
                                            <i class="bi bi-file-earmark-pdf"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- İstatistikler -->
            <div class="row mt-4">
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6 class="text-muted">Toplam Hakediş</h6>
                            <h4>@Model.Count()</h4>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6 class="text-muted">Hazırlanan</h6>
                            <h4>@Model.Count(h => h.Durum == HakedisYonetimSistemi.Models.HakedisDurum.Hazirlaniyor)</h4>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6 class="text-muted">Onaylanan</h6>
                            <h4>@Model.Count(h => h.Durum == HakedisYonetimSistemi.Models.HakedisDurum.Onaylandi)</h4>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6 class="text-muted">Ödenen</h6>
                            <h4>@Model.Count(h => h.Durum == HakedisYonetimSistemi.Models.HakedisDurum.Odendi)</h4>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Özet Bilgiler -->
            <div class="row mt-3">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <h6><i class="bi bi-calculator"></i> Finansal Özet</h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4">
                                    <strong>Toplam Hakediş Tutarı:</strong><br>
                                    <span class="text-primary fs-5">@Model.Sum(h => h.HakedisTutari).ToString("C", new System.Globalization.CultureInfo("tr-TR"))</span>
                                </div>
                                <div class="col-md-4">
                                    <strong>Toplam KDV:</strong><br>
                                    <span class="text-warning fs-5">@Model.Sum(h => h.KdvTutari).ToString("C", new System.Globalization.CultureInfo("tr-TR"))</span>
                                </div>
                                <div class="col-md-4">
                                    <strong>Genel Toplam:</strong><br>
                                    <span class="text-success fs-5"><strong>@Model.Sum(h => h.ToplamTutar).ToString("C", new System.Globalization.CultureInfo("tr-TR"))</strong></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-receipt display-1 text-muted"></i>
                <h4 class="mt-3">Henüz hakediş bulunmuyor</h4>
                <p class="text-muted">İlk hakediş oluşturmak için "Yeni Hakediş" butonuna tıklayın.</p>
                <a asp-action="Create" asp-route-projeId="@projeId" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Yeni Hakediş Oluştur
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () {
        $('#hakedisTable').DataTable({
            language: {
                url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/tr.json'
            },
            responsive: true,
            dom: '<"row mb-3"<"col-md-6"B><"col-md-6"f>>rtip',
            buttons: [
                {
                    extend: 'excel',
                    text: '<i class="bi bi-file-earmark-spreadsheet"></i> Excel',
                    className: 'btn btn-sm btn-success',
                    filename: 'HakedisList_' + new Date().toLocaleDateString('tr-TR')
                },
                {
                    extend: 'pdf',
                    text: '<i class="bi bi-file-earmark-pdf"></i> PDF',
                    className: 'btn btn-sm btn-danger',
                    filename: 'HakedisList_' + new Date().toLocaleDateString('tr-TR')
                },
                {
                    extend: 'print',
                    text: '<i class="bi bi-printer"></i> Yazdır',
                    className: 'btn btn-sm btn-info'
                },
                {
                    text: '<i class="bi bi-arrow-clockwise"></i> Yenile',
                    className: 'btn btn-sm btn-secondary',
                    action: function () {
                        location.reload();
                    }
                }
            ],
            pageLength: 10,
            columnDefs: [
                {
                    targets: -1,
                    orderable: false,
                    searchable: false
                }
            ],
            order: [[1, 'desc']]
        });
    });

    function printHakedisPDF(hakedisId) {
        window.open('/Hakedis/PrintPDF/' + hakedisId, '_blank');
    }
</script>
}
